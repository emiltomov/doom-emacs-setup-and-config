;;; doom-jetbrains-theme.el -*- lexical-binding: t; no-byte-compile: t; -*-

(require 'doom-themes)

(def-doom-theme doom-jetbrains
  "Charcoal editor surfaces and restrained JetBrains-style syntax colors."
  :background-mode 'dark
  ((bg         '("#1e1f22" nil nil))
   (bg-alt     '("#191a1c" nil nil))
   (base0      '("#141518" nil nil))
   (base1      '("#191a1c" nil nil))
   (base2      '("#26282d" nil nil))
   (base3      '("#2b2d30" nil nil))
   (base4      '("#393b40" nil nil))
   (base5      '("#5a5d63" nil nil))
   (base6      '("#7a7e85" nil nil))
   (base7      '("#9da0a8" nil nil))
   (base8      '("#dfe1e5" nil nil))
   (fg         '("#bcbec4" nil nil))
   (fg-alt     base7)
   (grey       base6)
   (red        '("#f75464" nil nil))
   (orange     '("#cf8e6d" nil nil))
   (green      '("#6aab73" nil nil))
   (teal       '("#2aacb8" nil nil))
   (yellow     '("#e2b765" nil nil))
   (blue       '("#56a8f5" nil nil))
   (dark-blue  '("#2d4f76" nil nil))
   (magenta    '("#c77dbb" nil nil))
   (violet     '("#b189c1" nil nil))
   (cyan       teal)
   (dark-cyan  '("#24727a" nil nil))
   (highlight  blue)
   (vertical-bar base4)
   (selection  '("#2d4f76" nil nil))
   (builtin    orange)
   (comments   base6)
   (doc-comments base6)
   (constants  magenta)
   (functions  blue)
   (keywords   orange)
   (methods    blue)
   (operators  fg)
   (type       fg)
   (strings    green)
   (variables  fg)
   (numbers    cyan)
   (region     selection)
   (error      red)
   (warning    yellow)
   (success    green)
   (vc-modified blue)
   (vc-added   green)
   (vc-deleted red)
   (added      '("#284436" nil nil))
   (removed    '("#442d30" nil nil)))
  ((cursor :background base8)
   (fringe :background bg :foreground base5)
   (hl-line :background base2)
   (line-number :background bg :foreground base5)
   (line-number-current-line :background base2 :foreground fg)
   (vertical-border :foreground base4)
   (window-divider :foreground base4)
   (window-divider-first-pixel :foreground base4)
   (window-divider-last-pixel :foreground base4)
   (mode-line :background base2 :foreground fg-alt :box nil)
   (mode-line-inactive :background bg-alt :foreground base6 :box nil)
   (header-line :background bg-alt :foreground fg :box nil :inherit 'variable-pitch)
   (tab-line :background bg-alt :foreground fg-alt :box nil)
   (centaur-tabs-default :background bg-alt :inherit 'variable-pitch)
   (centaur-tabs-selected
    :background base2 :foreground blue :box nil :weight 'normal :inherit 'variable-pitch)
   (centaur-tabs-unselected
    :background bg-alt :foreground fg-alt :box nil :inherit 'variable-pitch)
   (centaur-tabs-selected-modified :inherit 'centaur-tabs-selected :foreground blue)
   (centaur-tabs-unselected-modified :inherit 'centaur-tabs-unselected :foreground blue)
   (centaur-tabs-close-selected :inherit 'centaur-tabs-selected :foreground base6)
   (centaur-tabs-close-unselected :inherit 'centaur-tabs-unselected :foreground base6)
   (doom-modeline-bar :background base2)
   (css-selector :foreground yellow)
   (css-property :foreground fg)
   (css-proprietary-property :foreground fg)
   (show-paren-match :background base4 :foreground blue :weight 'normal)
   (rainbow-delimiters-depth-1-face :foreground yellow)
   (rainbow-delimiters-depth-2-face :foreground violet)
   (rainbow-delimiters-depth-3-face :foreground blue)
   (magit-section-heading :foreground fg :weight 'bold)
   (magit-section-highlight :background base3)
   (magit-header-line :background bg-alt :foreground fg :box nil :weight 'normal)
   (magit-filename :foreground blue)
   (magit-diff-file-heading :background bg-alt :foreground blue :weight 'bold)
   (magit-diff-file-heading-highlight :background base3 :foreground blue :weight 'bold)
   (magit-diff-hunk-heading :background base3 :foreground base7)
   (magit-diff-hunk-heading-highlight :background base4 :foreground fg)
   (magit-diff-context :background bg :foreground 'unspecified :extend t)
   (magit-diff-context-highlight :background bg :foreground 'unspecified :extend t)
   (magit-diff-added :background added :foreground 'unspecified :extend t)
   (magit-diff-added-highlight :background added :foreground 'unspecified :extend t)
   (magit-diff-removed :background removed :foreground 'unspecified :extend t)
   (magit-diff-removed-highlight :background removed :foreground 'unspecified :extend t)
   (magit-diff-added-indicator :foreground green)
   (magit-diff-removed-indicator :foreground red)
   (magit-diff-our :background removed :foreground 'unspecified :extend t)
   (magit-diff-their :background added :foreground 'unspecified :extend t)
   (diff-added :background added :foreground 'unspecified :extend t)
   (diff-removed :background removed :foreground 'unspecified :extend t)
   (diff-refine-added :background "#355c46" :foreground fg)
   (diff-refine-removed :background "#66383e" :foreground fg)))

(provide-theme 'doom-jetbrains)
